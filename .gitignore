# Ignore Terraform state files
*.tfstate
*.tfstate.backup
*.tfplan

# Ignore .terraform directory (local Terraform plugins and modules)
**/.terraform/

# Ignore .terraform.lock.hcl file
terraform.lock.hcl

# Ignore override files (useful for Terraform Cloud/Enterprise)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
terraform.rc

